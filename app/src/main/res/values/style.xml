<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AndroidHeadline">
        <item name="fontFamily">@font/roboto_font</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_size_28</item>
        <!--        <item name="lineHeight">36dp</item>-->
        <!--        <item name="android:letterSpacing">0</item>-->
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AndroidTitleMedium">
        <item name="fontFamily">@font/roboto_font</item>
        <item name="android:fontWeight">500</item>
        <item name="android:textSize">@dimen/text_size_16</item>
        <!--        <item name="lineHeight">18dp</item>-->
        <!--        <item name="android:letterSpacing">0.15</item>-->
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AndroidBodyMedium">
        <item name="fontFamily">@font/roboto_font</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textSize">@dimen/text_size_14</item>
        <!--        <item name="lineHeight">20dp</item>-->
        <!--        <item name="android:letterSpacing">0.25</item>-->
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="InputsMedium">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textColorHint">@color/light_gray</item>
        <item name="android:textAppearance">@style/AndroidBodyMedium</item>
        <item name="android:paddingStart">@dimen/padding_16</item>
        <item name="android:paddingEnd">@dimen/padding_16</item>
        <item name="maxLines">1</item>
    </style>

    <style name="ButtonTextMedium">
        <item name="fontFamily">@font/roboto_font</item>
        <item name="android:fontWeight">500</item>
        <item name="android:textSize">@dimen/text_size_14</item>
        <!--        <item name="lineHeight">20dp</item>-->
        <!--        <item name="android:letterSpacing">0.1</item>-->
    </style>

    <style name="ButtonMedium">
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/ButtonTextMedium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">@dimen/padding_10</item>
        <item name="android:paddingBottom">@dimen/padding_10</item>
        <item name="cornerRadius">@dimen/radius_30</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="ButtonTextSmall">
        <item name="fontFamily">@font/roboto_font</item>
        <item name="android:fontWeight">600</item>
        <item name="android:textSize">@dimen/text_size_12</item>
        <!--        <item name="lineHeight">15dp</item>-->
        <!--        <item name="android:letterSpacing">0.4</item>-->
        <item name="flow_horizontalAlign">center</item>
    </style>
</resources>